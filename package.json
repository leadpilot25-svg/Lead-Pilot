{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "build:landing": "cross-env VITE_APP_TARGET=landing vite build --outDir dist-landing",
    "build:crm": "cross-env VITE_APP_TARGET=crm vite build --outDir dist-crm",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "test:security": "tsx src/tests/securityVerification.ts",
    "test:controlled": "tsx src/tests/controlledLocalTest.ts",
    "test:sheetsync": "tsx src/tests/sheetSyncTest.ts",
    "test:appscript": "vitest run appsScriptSecurity",
    "test:cloudflare": "vitest run cloudflare",
    "test:prodrain": "vitest run prodrainFixes",
    "test:tenant": "vitest run tenantSecurityPhase1",
    "test:phase2d": "vitest run clientOwnerStaffAccess",
    "test:phase2d:emulator": "vitest run phase2dEmulatorIntegration",
    "test:rules:integration": "vitest run firestoreRulesIntegration",
    "test:routing": "vitest run clientRoutingPhase3",
    "test:phase3b:slug": "vitest run phase3bSlugEmulatorIntegration",
    "test:phase3b:routing": "vitest run dynamicTenantRoutingPhase3B",
    "test:all": "npm run test:security && npm run test:controlled && npm run test:sheetsync && npm run test:appscript && npm run test:cloudflare && npm run test:prodrain && npm run test:tenant && npm run test:phase2d && npm run test:phase2d:emulator && npm run test:rules:integration && npm run test:routing && npm run test:phase3b:slug && npm run test:phase3b:routing",
    "build:pages": "vite build"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^13.0.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
        "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "cross-env": "^10.1.0",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  }
}