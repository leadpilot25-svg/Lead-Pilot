# ==============================================================================
# LEADPILOT ENVIRONMENT CONFIGURATION
# ==============================================================================

# Target Deployment Environment
# Options:
#   'landing' - Public Landing Website: Standalone client landing page with Google Business Profile
#               info, lead capture form, WhatsApp integration. Zero dev or CRM controls.
#   'crm'     - Separate Client CRM: Customer-facing CRM with secure Firebase Auth, lead dashboard,
#               follow-up reminders, WhatsApp action buttons. Zero dev controls or landing preview.
#   'dev'     - Internal Development Environment: Master suite with Dev Mode, Client Mode preview,
#               Config Editor Drawer, Code Exporter.
VITE_APP_TARGET=dev

# Scoped Client Identifier (e.g. demo-tarot-kochi, client-apex-hvac, demo-plumbing)
VITE_CLIENT_ID=demo-tarot-kochi

# Optional Google Apps Script Web App URL (public lead form endpoint)
# Configured per tenant in Root Admin -> Website Manager -> Edit Content -> Integrations (CONFIG.formEndpoint)
# OR supplied at build time using per-tenant variables below:
VITE_FORM_ENDPOINT=https://script.google.com/macros/s/AKfycbx.../exec
VITE_FORM_ENDPOINT_TAROT=
VITE_FORM_ENDPOINT_PRODRAIN=
VITE_FORM_ENDPOINT_APEX=
VITE_FORM_ENDPOINT_ROOFING=

# Cloudflare Pages Server Secrets (for /api/sync-sheet CRM sync gateway)
# Format: APPSCRIPT_ENDPOINT_<TENANT_ID_UPPER_SNAKE> and APPSCRIPT_KEY_<TENANT_ID_UPPER_SNAKE>
APPSCRIPT_ENDPOINT_DEMO_TAROT_KOCHI=
APPSCRIPT_KEY_DEMO_TAROT_KOCHI=
ROOT_ADMIN_UID=
FIREBASE_SERVICE_ACCOUNT_JSON=

